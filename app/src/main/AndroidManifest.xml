<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- FA-96: mirror scheduled workouts to the device Calendar Provider. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <!-- FTNSSLNK-260: push notifications (runtime-requested on Android 13+). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Health Connect, read-only (iOS Apple Health counterpart). One permission
         per data type HealthConnectService reads; nothing is ever written. -->
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_ACTIVE_CALORIES_BURNED" />
    <uses-permission android:name="android.permission.health.READ_EXERCISE" />
    <uses-permission android:name="android.permission.health.READ_SLEEP" />
    <uses-permission android:name="android.permission.health.READ_RESTING_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE_VARIABILITY" />
    <uses-permission android:name="android.permission.health.READ_BODY_FAT" />

    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- Android 13 and lower: Health Connect is a separate app the SDK must see. -->
    <queries>
        <package android:name="com.google.android.apps.healthdata" />
    </queries>

    <!-- Phase 1 is phones only (tablets come in 2027): Google Play only
         offers the app to "normal"-size screens, the bucket every Pixel
         phone is in. This excludes small screens, tablets, Chromebooks and
         large foldables. Every density is listed because Play also filters
         on any density missing from this list. Remove this block when
         tablet support lands. -->
    <compatible-screens>
        <screen android:screenSize="normal" android:screenDensity="ldpi" />
        <screen android:screenSize="normal" android:screenDensity="mdpi" />
        <screen android:screenSize="normal" android:screenDensity="213" />
        <screen android:screenSize="normal" android:screenDensity="hdpi" />
        <screen android:screenSize="normal" android:screenDensity="260" />
        <screen android:screenSize="normal" android:screenDensity="280" />
        <screen android:screenSize="normal" android:screenDensity="300" />
        <screen android:screenSize="normal" android:screenDensity="xhdpi" />
        <screen android:screenSize="normal" android:screenDensity="340" />
        <screen android:screenSize="normal" android:screenDensity="360" />
        <screen android:screenSize="normal" android:screenDensity="400" />
        <screen android:screenSize="normal" android:screenDensity="420" />
        <screen android:screenSize="normal" android:screenDensity="440" />
        <screen android:screenSize="normal" android:screenDensity="450" />
        <screen android:screenSize="normal" android:screenDensity="xxhdpi" />
        <screen android:screenSize="normal" android:screenDensity="520" />
        <screen android:screenSize="normal" android:screenDensity="560" />
        <screen android:screenSize="normal" android:screenDensity="600" />
        <screen android:screenSize="normal" android:screenDensity="xxxhdpi" />
    </compatible-screens>

    <application
        android:usesCleartextTraffic="true"
        android:name=".FitnessLinkApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.FitnessLink"
        tools:targetApi="35">
        <!-- singleTask so a notification tap while the app is alive arrives
             via onNewIntent instead of stacking a second MainActivity.
             Phase 1 is phones in portrait only (tablets excluded in the
             Play Console device catalog). Android ignores this lock on
             screens 600dp+ once targetSdk is 36. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:configChanges="uiMode"
            android:theme="@style/Theme.FitnessLink.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Health Connect privacy rationale. Android 13 and lower open it with
             ACTION_SHOW_PERMISSIONS_RATIONALE; Android 14+ through the
             VIEW_PERMISSION_USAGE alias below. Health Connect refuses the
             permission request when neither is declared. -->
        <activity
            android:name=".health.HealthPermissionsRationaleActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:targetActivity=".health.HealthPermissionsRationaleActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <!-- FTNSSLNK-260/261: FCM token + message delivery. -->
        <service
            android:name=".push.FitnessLinkMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Background notification messages rendered by FCM land on our
             channel (created in PushNotificationManager.start). -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="fitnesslink_default" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_fitnesslink" />
    </application>

</manifest>
