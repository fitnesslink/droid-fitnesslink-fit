<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- FTNSSLNK-540: day half of a DayNight pair (night half in values-night/themes.xml).
         Bars are transparent under enableEdgeToEdge(); FitnessLinkTheme flips the
         bar icon contrast to follow the in-app Appearance. windowBackground is what
         shows before the first Compose frame and between screens. -->
    <style name="Theme.FitnessLink" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/fl_window_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
    </style>
</resources>
